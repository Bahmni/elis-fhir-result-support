<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <bean id="observationExtractor"
          class="org.bahmni.module.elisFhirResultSupport.api.helper.ObservationExtractor">
    </bean>

    <bean id="elisFhirDiagnosticReportService"
          class="org.bahmni.module.elisFhirResultSupport.api.service.impl.ElisFhirDiagnosticReportServiceImpl">
        <constructor-arg ref="observationExtractor"/>
        <constructor-arg ref="bahmniFhirDiagnosticReportDao"/>
    </bean>

    <bean id="elisResultPostSaveCommand"
          class="org.bahmni.module.elisFhirResultSupport.api.command.impl.ElisResultServiceImpl">
        <constructor-arg ref="orderService"/>
        <constructor-arg ref="elisFhirDiagnosticReportService"/>
    </bean>

</beans>
